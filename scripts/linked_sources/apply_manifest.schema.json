{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cvf:operations:linked-source-apply-manifest:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workspaceId",
    "baseCommit",
    "candidateCommit",
    "scanDatasetSha256",
    "filteringPolicyVersion",
    "filteringPolicySha256",
    "entries",
    "authorizationReceiptPath",
    "manifestSha256"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "workspaceId": {"const": "cvf-operations-workspace"},
    "baseCommit": {"$ref": "#/$defs/commit"},
    "candidateCommit": {"$ref": "#/$defs/commit"},
    "scanDatasetSha256": {"$ref": "#/$defs/hash"},
    "filteringPolicyVersion": {"const": "1.0"},
    "filteringPolicySha256": {"$ref": "#/$defs/hash"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/newEntry"},
          {"$ref": "#/$defs/modifiedEntry"},
          {"$ref": "#/$defs/deletedEntry"},
          {"$ref": "#/$defs/renamedEntry"}
        ]
      }
    },
    "authorizationReceiptPath": {"type": "string", "minLength": 1},
    "manifestSha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "absent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {"state": {"const": "ABSENT"}}
    },
    "present": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "sha256"],
      "properties": {
        "state": {"const": "PRESENT"},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "newEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "candidateSourcePath", "candidateSourceBlobSha256", "candidateSourceGitMode", "destinationPath", "destinationPrecondition"],
      "properties": {
        "operation": {"const": "new"},
        "candidateSourcePath": {"type": "string", "minLength": 1},
        "candidateSourceBlobSha256": {"$ref": "#/$defs/hash"},
        "candidateSourceGitMode": {"type": "string", "pattern": "^100[67][0-9]{2}$"},
        "destinationPath": {"type": "string", "minLength": 1},
        "destinationPrecondition": {"$ref": "#/$defs/absent"}
      }
    },
    "modifiedEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "candidateSourcePath", "candidateSourceBlobSha256", "candidateSourceGitMode", "destinationPath", "destinationPrecondition"],
      "properties": {
        "operation": {"const": "modified"},
        "candidateSourcePath": {"type": "string", "minLength": 1},
        "candidateSourceBlobSha256": {"$ref": "#/$defs/hash"},
        "candidateSourceGitMode": {"type": "string", "pattern": "^100[67][0-9]{2}$"},
        "destinationPath": {"type": "string", "minLength": 1},
        "destinationPrecondition": {"$ref": "#/$defs/present"}
      }
    },
    "deletedEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "baseSourcePath", "baseBlobSha256", "destinationPath", "destinationPrecondition"],
      "properties": {
        "operation": {"const": "deleted"},
        "baseSourcePath": {"type": "string", "minLength": 1},
        "baseBlobSha256": {"$ref": "#/$defs/hash"},
        "destinationPath": {"type": "string", "minLength": 1},
        "destinationPrecondition": {"$ref": "#/$defs/present"}
      }
    },
    "renamedEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "oldSourcePath", "newSourcePath", "baseBlobSha256", "candidateBlobSha256", "candidateSourceGitMode", "oldDestinationPath", "newDestinationPath", "contentChanged", "oldDestinationPrecondition", "newDestinationPrecondition"],
      "properties": {
        "operation": {"const": "renamed"},
        "oldSourcePath": {"type": "string", "minLength": 1},
        "newSourcePath": {"type": "string", "minLength": 1},
        "baseBlobSha256": {"$ref": "#/$defs/hash"},
        "candidateBlobSha256": {"$ref": "#/$defs/hash"},
        "candidateSourceGitMode": {"type": "string", "pattern": "^100[67][0-9]{2}$"},
        "oldDestinationPath": {"type": "string", "minLength": 1},
        "newDestinationPath": {"type": "string", "minLength": 1},
        "contentChanged": {"type": "boolean"},
        "oldDestinationPrecondition": {"$ref": "#/$defs/present"},
        "newDestinationPrecondition": {"$ref": "#/$defs/absent"}
      }
    }
  }
}
